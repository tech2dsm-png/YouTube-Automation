# =================================================================
# 1. PYTHON SETTINGS & VIRTUAL ENVIRONMENTS
# =================================================================
venv/
.env
__pycache__/
*.pyc
*.pyo
*.pyd

# =================================================================
# 2. VIDEO FILES & THE AUTOMATION PIPELINE
# =================================================================
# Ignore actual videos but allow the folders to exist on GitHub
videos/*
uploaded/*
failed_uploads/*
uploaded-to-drive/*

# Allow .gitkeep files so empty folders are tracked
!videos/.gitkeep
!uploaded/.gitkeep
!failed_uploads/.gitkeep
!uploaded-to-drive/.gitkeep

# Ignore common video formats
*.mp4
*.mov
*.avi
*.mkv

# =================================================================
# 3. SECURITY: KEYS, PASSWORDS & TOKENS
# =================================================================
# IMPORTANT: These must stay out of GitHub for security
credentials/
token.json
client_secrets.json
service-account.json
*.json
*.pem

# =================================================================
# 4. DATABASE & LOG FILES
# =================================================================
logs/*.log
*.db
*.db-journal
*.db-wal
*.db-shm

# =================================================================
# 5. IDE & SYSTEM JUNK
# =================================================================
.DS_Store
Thumbs.db
.idea/
.vscode/